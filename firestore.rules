rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function currentUserData() {
      return userDoc(request.auth.uid).data;
    }

    function belongsToHousehold(householdId) {
      return isAuthenticated()
        && userExists(request.auth.uid)
        && currentUserData().householdId == householdId;
    }

    function isHouseholdAdmin(householdId) {
      return belongsToHousehold(householdId)
        && currentUserData().role == 'familyAdmin';
    }

    function isHouseholdMember(householdId) {
      return belongsToHousehold(householdId)
        && currentUserData().role in ['familyAdmin', 'familyMember'];
    }

    function validGroceryItemFields() {
      return request.resource.data.keys().hasAll([
          'name', 'quantity', 'isChecked', 'addedBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.quantity is string
        && request.resource.data.quantity.size() <= 50
        && request.resource.data.isChecked is bool
        && request.resource.data.addedBy is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // users/{userId}
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isAuthenticated()
        && (
          request.auth.uid == userId
          || (
            userExists(request.auth.uid)
            && resource.data.householdId != null
            && resource.data.householdId == currentUserData().householdId
          )
        );

      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['email', 'displayName', 'role', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.role == 'familyMember'
        && request.resource.data.createdAt is timestamp
        && !('householdId' in request.resource.data);

      allow update: if isAuthenticated() && (
        // User updates own profile (display name only)
        (
          request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'updatedAt'])
        )
        // Admin assigns household + role when inviting/joining
        || (
          isHouseholdAdmin(resource.data.householdId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['householdId', 'role', 'updatedAt'])
          && request.resource.data.role in ['familyAdmin', 'familyMember']
        )
        // User joins a household (self-assign householdId)
        || (
          request.auth.uid == userId
          && resource.data.householdId == null
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['householdId', 'role', 'updatedAt'])
          && request.resource.data.role in ['familyAdmin', 'familyMember']
        )
      );

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // households/{householdId}
    // -------------------------------------------------------------------------
    match /households/{householdId} {
      allow read: if isHouseholdMember(householdId);

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll([
             'name', 'inviteCode', 'createdBy', 'createdAt'
           ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 6
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp;

      allow update: if isHouseholdAdmin(householdId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'updatedAt']);

      allow delete: if isHouseholdAdmin(householdId);

      // -----------------------------------------------------------------------
      // households/{householdId}/items/{itemId}  — shared grocery list
      // -----------------------------------------------------------------------
      match /items/{itemId} {
        allow read: if isHouseholdMember(householdId);

        allow create: if isHouseholdMember(householdId)
          && validGroceryItemFields()
          && request.resource.data.addedBy == request.auth.uid;

        allow update: if isHouseholdMember(householdId)
          && validGroceryItemFields()
          && request.resource.data.addedBy == resource.data.addedBy
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if isHouseholdMember(householdId);
      }
    }

    // -------------------------------------------------------------------------
    // inviteCodes/{code}  — lookup table for joining households
    // -------------------------------------------------------------------------
    match /inviteCodes/{code} {
      allow read: if isAuthenticated();

      // Created atomically when a user creates a new household
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['householdId', 'createdAt'])
        && request.resource.data.householdId is string
        && request.resource.data.createdAt is timestamp
        && get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.createdBy == request.auth.uid;

      allow update, delete: if false;
    }
  }
}
