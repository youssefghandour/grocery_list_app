rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // This rule allows ANY authenticated user to read/write ANY collection.
    // Use this to verify that the code is working, then we can restrict it.
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Explicit support for your background search (Collection Group)
    match /{path=**}/items/{itemId} {
      allow read, write: if isAuthenticated();
    }
  }
}